    "custom_liquid_tyB6WN": {
      "type": "custom-liquid",
      "name": "Custom liquid",
      "settings": {
        "custom_liquid": "<!-- ZIP Delivery Checker – Final with localStorage + orange accent + Enter fix -->\n<div id=\"midnyt-zipc-{{ section.id }}\" class=\"midnyt-zipc\"\n     data-csv=\"{{ 'zip-delivery.csv' | file_url | escape }}\">\n  <div class=\"mc-card\" role=\"region\" aria-labelledby=\"mc-title-{{ section.id }}\">\n    <!-- LEFT -->\n    <div class=\"mc-left\">\n      <div class=\"mc-badge\" aria-hidden=\"true\">\n        <svg viewBox=\"0 0 24 24\" width=\"28\" height=\"28\" fill=\"none\" stroke=\"black\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M12 22s8-7.33 8-13a8 8 0 1 0-16 0c0 5.67 8 13 8 13z\"></path>\n          <circle cx=\"12\" cy=\"9\" r=\"3\"></circle>\n        </svg>\n      </div>\n\n      <div class=\"mc-copy\">\n        <h2 id=\"mc-title-{{ section.id }}\" class=\"mc-title\">Postleitzahl überprüfen</h2>\n        <form class=\"mc-form\" novalidate>\n          <input id=\"mc-zip-{{ section.id }}\" class=\"mc-input\"\n                 name=\"zip\" inputmode=\"numeric\" pattern=\"[0-9]*\" maxlength=\"4\"\n                 placeholder=\"PLZ z. B. 8001\" aria-label=\"PLZ eingeben\" autocomplete=\"off\">\n          <div class=\"mc-help\">Gib deine PLZ ein, um die Lieferung zu prüfen.</div>\n        </form>\n      </div>\n    </div>\n\n    <!-- RIGHT / STATUS -->\n    <div class=\"mc-right\">\n      <div class=\"mc-status\">\n        <span class=\"mc-status-dot\" aria-hidden=\"true\"></span>\n        <span class=\"mc-status-text mc-muted\">Bitte PLZ eingeben.</span>\n      </div>\n      <div class=\"mc-sub\"></div>\n    </div>\n  </div>\n</div>\n\n<style>\n.midnyt-zipc{\n  --card-bg:#f3f4f6;\n  --accent:#FB5B03; /* orange accent */\n  --radius:32px;\n  --pad-x:20px; --pad-y:20px; --gap:24px;\n  --badge:64px; --badge-radius:18px;\n  --input-h:52px; --maxw:1100px;\n  width:100%; display:flex; justify-content:center;\n}\n@media(min-width:960px){\n  .midnyt-zipc{--pad-x:32px;--pad-y:24px;--gap:36px;--badge:72px;--badge-radius:20px;--maxw:1250px;}\n}\n.midnyt-zipc .mc-card{\n  width:100%;max-width:var(--maxw);margin:0 auto;\n  padding:var(--pad-y) var(--pad-x);\n  border-radius:var(--radius);background:var(--card-bg);\n  display:grid;grid-template-columns:1fr auto;align-items:center;column-gap:var(--gap);\n}\n.midnyt-zipc .mc-left{display:grid;grid-template-columns:var(--badge) 1fr;align-items:center;column-gap:18px;}\n.midnyt-zipc .mc-badge{width:var(--badge);height:var(--badge);border-radius:var(--badge-radius);background:var(--accent);display:grid;place-items:center;}\n.midnyt-zipc .mc-title{margin:0 0 10px;font-size:28px;line-height:1.1;font-weight:800;}\n@media(max-width:960px){.midnyt-zipc .mc-title{font-size:26px;}}\n.midnyt-zipc .mc-input{\n  width:100%;height:var(--input-h);padding:0 16px;font-size:16px;\n  border-radius:14px;border:1px solid #d9d9dc;background:#fff;\n  outline:none;transition:border-color .2s; box-shadow:0 1px 0 rgba(0,0,0,.04) inset;\n}\n.midnyt-zipc .mc-input:focus{border-color:#000;}\n.midnyt-zipc .mc-help{margin-top:8px;font-size:14px;color:#6a6a6a;}\n.midnyt-zipc .mc-right{display:flex;flex-direction:column;align-items:flex-end;text-align:right;min-width:250px;}\n.midnyt-zipc .mc-status{display:flex;align-items:center;gap:10px;}\n.midnyt-zipc .mc-status-dot{width:30px;height:30px;border-radius:10px;background:var(--accent);display:grid;place-items:center;}\n.midnyt-zipc .mc-status-text{font-size:18px;font-weight:800;color:#333;}\n.midnyt-zipc .mc-sub{margin-top:4px;font-size:14px;color:#444;opacity:.9;}\n.midnyt-zipc .is-success .mc-status-text{color:var(--accent);}\n.midnyt-zipc .is-error .mc-status-text{color:#b00020;}\n.midnyt-zipc .is-success .mc-status-dot::after{content:\"✔\";font-size:16px;color:var(--accent);font-weight:700;}\n.midnyt-zipc .is-error .mc-status-dot::after{content:\"✖\";font-size:16px;color:#b00020;font-weight:700;}\n@media(max-width:768px){\n  .midnyt-zipc .mc-card{grid-template-columns:1fr;row-gap:14px;}\n  .midnyt-zipc .mc-right{align-items:flex-start;text-align:left;padding-left:calc(var(--badge)+18px);}\n  .midnyt-zipc .mc-status-text{font-size:20px;}\n}\n</style>\n\n<script>\n(function(){\n  const root = document.getElementById('midnyt-zipc-{{ section.id }}');\n  if(!root) return;\n\n  const CSV_URL = root.getAttribute('data-csv');\n  const form   = root.querySelector('.mc-form');\n  const input  = root.querySelector('.mc-input');\n  const status = root.querySelector('.mc-status');\n  const textEl = root.querySelector('.mc-status-text');\n  const subEl  = root.querySelector('.mc-sub');\n  let map = null;\n\n  function parseCSV(text){\n    const lines = text.trim().split(/\\r?\\n/).filter(Boolean);\n    if(!lines.length) return {};\n    const headerRaw = lines[0].toLowerCase();\n    const delim = (headerRaw.includes(';') && !headerRaw.includes(',')) ? ';' : ',';\n    const headers = headerRaw.split(delim).map(h=>h.trim());\n    const idx = re => headers.findIndex(h => re.test(h));\n    let iZip = idx(/^(zip|plz|postal|postleitzahl)$/); if(iZip<0) iZip = 0;\n    const iMin  = idx(/(min[_ ]?order|minorder|min_betrag|mindestbetrag|minimum|minbestellwert)/);\n    const iOpen = idx(/(open[_ ]?time|öffnet|open|time|uhr|opening|opening_time)/);\n    const iCity = idx(/(city|ort|stadt|locality)/);\n    const out = {};\n    for(let r=1; r<lines.length; r++){\n      const cols = lines[r].split(delim).map(c => c.trim());\n      let zip = ((cols[iZip]||'').match(/\\d+/)||[''])[0];\n      zip = zip ? zip.padStart(4,'0') : '';\n      if(!zip) continue;\n      const rawMin = (iMin>=0)? (cols[iMin]||'') : '';\n      const min = rawMin ? parseFloat(rawMin.replace(',','.').replace(/\\s/g,'')) : NaN;\n      const open = (iOpen>=0)? (cols[iOpen]||'') : '';\n      const city = (iCity>=0)? (cols[iCity]||'') : '';\n      out[zip] = { min_order: isFinite(min) ? min : null, open_time: open, city: city };\n    }\n    return out;\n  }\n\n  function formatCHF(n){\n    try { return new Intl.NumberFormat('de-CH',{style:'currency',currency:'CHF',maximumFractionDigits:2}).format(n); }\n    catch { return 'CHF ' + Number(n).toFixed(2); }\n  }\n\n  function setState(type,zip,city,rec){\n    status.classList.remove('is-success','is-error');\n    if(type === 'success'){\n      status.classList.add('is-success');\n      const parts=[];\n      if(rec && rec.min_order != null) parts.push('Mindestbestellwert: ' + formatCHF(rec.min_order));\n      if(rec && rec.open_time)         parts.push('öffnet um ' + rec.open_time);\n      textEl.textContent = parts.join(' | ') || 'Lieferbar';\n      subEl.textContent = [zip, city].filter(Boolean).join(' ');\n    }else if(type === 'error'){\n      status.classList.add('is-error');\n      textEl.textContent = 'Sorry, wir liefern nicht in dieses Gebiet.';\n      subEl.textContent = zip || '';\n    }else{\n      textEl.textContent = 'Bitte PLZ eingeben.';\n      subEl.textContent = '';\n    }\n  }\n\n  async function loadCSV(){\n    try{\n      const res = await fetch(CSV_URL, { cache:'no-store' });\n      if(!res.ok) throw new Error('CSV not found');\n      const text = await res.text();\n      map = parseCSV(text);\n\n      // Prefill from localStorage (keeps ZIP visible on reload)\n      try {\n        const saved = JSON.parse(localStorage.getItem('midnytZipInfo') || '{}');\n        if (saved && saved.zip) {\n          input.value = saved.zip;\n          handle(saved.zip);\n        }\n      } catch(e){}\n    }catch(e){\n      console.error('[ZIP Checker] CSV load error:', e);\n      setState('error','','',null);\n      textEl.textContent = 'Daten konnten nicht geladen werden.';\n    }\n  }\n\n  function handle(zipRaw){\n    if(!map) return;\n    const zip = (zipRaw||'').replace(/\\D/g,'').slice(0,4).padStart(4,'0');\n    const rec = map[zip];\n    if(zip.length < 4){\n      setState('idle');\n      return;\n    }\n    if(rec){\n      setState('success', zip, rec.city || '', rec);\n      localStorage.setItem('midnytZipInfo', JSON.stringify({\n        zip: zip,\n        min_order: rec.min_order || 0\n      }));\n    }else{\n      setState('error', zip, '', null);\n    }\n  }\n\n  loadCSV();\n\n  input.addEventListener('input', () => {\n    const v = input.value.replace(/\\D/g,'').slice(0,4);\n    input.value = v;\n    handle(v);\n  });\n  input.addEventListener('blur', () => handle(input.value));\n\n  form.addEventListener('submit', (e) => {\n    e.preventDefault();\n    handle(input.value);\n  });\n  input.addEventListener('keydown', (e) => {\n    if (e.key === 'Enter') {\n      e.preventDefault();\n      handle(input.value);\n    }\n  });\n})();\n</script>",
        "custom_class": ""
      }
    },
